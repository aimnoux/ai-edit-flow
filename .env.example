# Copy to .env (ignored by git). Needed only for speech-to-text, voice cloning and music:
# engine/stt.py, engine/voice.py, engine/tts_elevenlabs.py
ELEVENLABS_API_KEY=
# Optional dedicated rendering executable: chrome-headless-shell only.
# setup.sh downloads a dedicated browser automatically on supported platforms.
# Personal Google Chrome is never auto-detected; do not point this at its app/executable.
# CHROME_PATH=/absolute/path/to/chrome-headless-shell
