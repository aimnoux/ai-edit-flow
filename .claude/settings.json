{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(python3 engine/*)",
      "Bash(python engine/*)",
      "Bash(bash engine/render.sh:*)",
      "Bash(bash setup.sh:*)",
      "Bash(node engine/hf.mjs:*)",
      "Bash(node --check:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)"
    ]
  }
}
